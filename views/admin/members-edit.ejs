<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Member | Kalikamai Admin</title>
    <style>
        body { font-family: 'Inter', sans-serif; margin: 0; padding: 2rem; background: #f1f5f9; color: #334155; }
        .container { max-width: 800px; margin: 0 auto; background: white; padding: 2rem; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
        .form-row { display: flex; gap: 1rem; margin-bottom: 1.5rem; }
        .form-group { flex: 1; }
        label { display: block; margin-bottom: 0.5rem; font-weight: 500; }
        input[type="text"], input[type="number"], input[type="url"], select { width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 5px; box-sizing: border-box; }
        .btn { padding: 0.75rem 1.5rem; border: none; border-radius: 5px; color: white; cursor: pointer; font-size: 1rem; text-decoration: none; display: inline-block; }
        .btn-primary { background: #0ea5e9; }
        .btn-secondary { background: #64748b; margin-right: 1rem; }
        h1 { margin-top: 0; margin-bottom: 2rem; }
        .section-title { font-weight: 600; font-size: 1.1rem; margin-top: 2rem; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid #e2e8f0; }
        .current-img { max-width: 100px; border-radius: 5px; display: block; margin-bottom: 0.5rem; }
    </style>
</head>
<body>
    <div class="container">
        <h1>Edit Member</h1>
        <form action="/admin/members/edit/<%= member.id %>" method="POST" enctype="multipart/form-data">
            
            <div class="form-row">
                <div class="form-group">
                    <label for="name">Full Name *</label>
                    <input type="text" id="name" name="name" value="<%= member.name %>" required>
                </div>
                <div class="form-group">
                    <label for="role">Role * (e.g. President)</label>
                    <input type="text" id="role" name="role" value="<%= member.role %>" required>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="department">Department / Education</label>
                    <input type="text" id="department" name="department" value="<%= member.department %>">
                </div>
                <div class="form-group">
                    <label for="phone">Phone Number</label>
                    <input type="text" id="phone" name="phone" value="<%= member.phone %>">
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="display_order">Display Order</label>
                    <input type="number" id="display_order" name="display_order" value="<%= member.display_order %>">
                </div>
                <div class="form-group">
                    <label for="image">Profile Image (Leave blank to keep current)</label>
                    <% if (member.image_url) { %>
                        <img src="/<%= member.image_url %>" class="current-img">
                    <% } %>
                    <input type="file" id="image" name="image" accept="image/*">
                </div>
            </div>

            <div class="section-title">Social Links (Optional)</div>
            
            <div class="form-row">
                <div class="form-group">
                    <label for="facebook_url">Facebook URL</label>
                    <input type="url" id="facebook_url" name="facebook_url" value="<%= member.facebook_url %>">
                </div>
                <div class="form-group">
                    <label for="twitter_url">Twitter URL</label>
                    <input type="url" id="twitter_url" name="twitter_url" value="<%= member.twitter_url %>">
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="google_url">Google/Email Link</label>
                    <input type="url" id="google_url" name="google_url" value="<%= member.google_url %>">
                </div>
                <div class="form-group">
                    <label for="linkedin_url">LinkedIn URL</label>
                    <input type="url" id="linkedin_url" name="linkedin_url" value="<%= member.linkedin_url %>">
                </div>
            </div>

            <div style="margin-top: 2rem;">
                <a href="/admin/members" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Update Member</button>
            </div>
        </form>
    </div>
</body>
</html>
