        .dev-role { display: inline-block; background: linear-gradient(135deg, #0ea5e9, #0284c7); color: white; font-size: 0.85rem; font-weight: 700; padding: 0.4rem 1.2rem; border-radius: 50px; text-transform: uppercase; margin-bottom: 1.5rem; }
