<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>कालिकामाई युवा समाज | Kalikamai Youth Society</title>
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&family=Inter:wght@400;500;600&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="style.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Homepage mobile responsive overrides */
        @media (max-width: 768px) {
            /* Hero section overrides */
            .hero {
                padding-top: 100px !important;
                align-items: flex-start !important;
            }
            .hero-content.glass-card {
                padding: 2rem 1.5rem !important;
                margin-top: 20px !important;
            }
            .hero-content .hero-title:first-child {
                font-size: 1.8rem !important;
            }
            .hero-content .hero-title:nth-child(2) {
                font-size: 1.5rem !important;
            }
            .hero-content .hero-description {
                font-size: 1rem !important;
                margin-bottom: 1.5rem !important;
            }
            
            .vision-mission-section {
                flex-direction: column !important;
                min-height: auto !important;
            }
            .vision-mission-section > div {
                flex: 1 1 100% !important;
                min-width: 100% !important;
                padding: 3rem 6% !important;
            }
            .vision-mission-section h2 {
                font-size: 2rem !important;
            }
            .vision-mission-section p {
                font-size: 1rem !important;
            }
            /* Stats pill */
            .stats-pill-section {
                margin-top: -60px !important;
                padding-left: 1rem !important;
                padding-right: 1rem !important;
            }
            .stats-pill-section > div {
                border-radius: 30px !important;
                border-width: 8px !important;
                padding: 2rem 1.5rem !important;
                gap: 1.5rem !important;
            }
            .stats-pill-section .stat-number {
                font-size: 2.5rem !important;
            }
            /* Organizational identity section */
            .identity-section {
                min-height: auto !important;
                padding: 2rem 0 !important;
                flex-direction: column !important;
            }
            .identity-section > div:first-child {
                position: relative !important;
                width: 100% !important;
                height: 200px !important;
            }
            .identity-section > div:nth-child(2) {
                width: 95% !important;
                max-width: 100% !important;
                padding: 2rem !important;
                border-radius: 0 20px 20px 0 !important;
                margin-top: -30px !important;
            }
            .identity-section > div:nth-child(2) h2 {
                font-size: 2rem !important;
            }
            .identity-section > div:nth-child(2) p {
                font-size: 1.05rem !important;
            }
            /* Careers section */
            .section#careers > .container > div {
                padding: 2rem !important;
                flex-direction: column !important;
            }
            .section#careers h2 {
                font-size: 2rem !important;
            }
            /* News title row */
            .news-section .container > div:first-child h2 {
                font-size: 1.6rem !important;
            }
            /* Testimonial header */
            .testimonials-section .text-center h2 {
                font-size: 2.2rem !important;
            }
        }
        @media (max-width: 480px) {
            .vision-mission-section > div {
                padding: 2rem 5% !important;
            }
            .vision-mission-section h2 {
                font-size: 1.6rem !important;
                gap: 0.8rem !important;
            }
            .vision-mission-section h2 i {
                font-size: 1.8rem !important;
            }
            .stats-pill-section > div {
                padding: 1.5rem 1rem !important;
                border-width: 5px !important;
                border-radius: 24px !important;
            }
            .stats-pill-section .stat-number {
                font-size: 2rem !important;
            }
            .identity-section > div:nth-child(2) h2 {
                font-size: 1.6rem !important;
            }
        }
    </style>
</head>

<body>

    <!-- Navigation -->
    <nav class="navbar">
        <div class="nav-container">
            <a href="/" class="logo">
                <img src="/assets/logo.jpeg" alt="Kalikamai Youth Society" class="logo-img">
                <span class="logo-text">कालिकामाई युवा<br>समाज</span>
            </a>
            <div class="nav-links">
                <a href="/about.html">About Us</a>
                <a href="/work.html">Our Work</a>
                <a href="/members.html">Our Members</a>
                <a href="/impact.html">Our Impact</a>
                <a href="/projects.html">Projects</a>
                <a href="/contact.html">Contact</a>
            </div>
            <div class="nav-actions">
                <a href="/admin/login" class="btn btn-outline">Login</a>
                <a href="/donate.html" class="btn btn-primary">Support Us</a>
                <button class="mobile-menu-btn"><i class="fa-solid fa-bars"></i></button>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <header class="hero" id="home">
        <!-- The background image will be set via CSS -->
        <div class="hero-overlay"></div>
        <div class="hero-content glass-card" style="max-width: 900px; margin: 0 auto;">
            <h1 class="hero-title" style="margin-bottom: 0.5rem; font-size: 3rem; color: #fca311; text-shadow: 0 4px 10px rgba(0,0,0,0.5);">युवा सशक्तिकरण, समुदाय रूपान्तरण</h1>
            <h1 class="hero-title" style="font-size: 2.2rem; margin-top: 0; margin-bottom: 1.5rem;">Empowering Youth,<br>Transforming Communities.</h1>
            <p class="hero-description" style="max-width: 700px; margin: 0 auto 2.5rem auto;">Since our inception, we have believed that small steps taken together can lead
                to significant change. Join us in building a better, brighter future for our society.</p>
            <div class="hero-buttons">
                <a href="work.html" class="btn btn-primary btn-lg btn-pulse">Explore Our Work</a>
                <a href="impact.html" class="btn btn-outline btn-lg" style="border-color: rgba(255,255,255,0.5); background: rgba(0,0,0,0.2);">See Our Impact</a>
            </div>
        </div>
        <div class="scroll-indicator">
            <div class="mouse">
                <div class="wheel"></div>
            </div>
        </div>
    </header>
    <!-- Vision, Mission & Impact Section -->
    <section class="vision-mission-cards">
        <div class="vm-card">
            <h2 style="font-size: 2.5rem; display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; color: #111827; font-family: var(--font-heading);">
                <i class="fa-solid fa-bullseye" style="color: #fca311; font-size: 2.2rem;"></i> 
                <div>हाम्रो अभियान<br><span style="font-size: 1.2rem; color: #64748b;">Our Mission</span></div>
            </h2>
            <p style="font-size: 1.15rem; line-height: 1.8; color: #475569; font-weight: 500;">
                Kalikamai Youth Society empowers disenfranchised communities in Nepal to achieve sustainable
                development and social justice by implementing collaborative, community-led solutions for
                positive transformation.
            </p>
        </div>
        
        <div class="vm-card">
            <h2 style="font-size: 2.5rem; display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; color: #111827; font-family: var(--font-heading);">
                <i class="fa-solid fa-eye" style="color: #0ea5e9; font-size: 2.2rem;"></i> 
                <div>हाम्रो दृष्टि<br><span style="font-size: 1.2rem; color: #64748b;">Our Vision</span></div>
            </h2>
            <p style="font-size: 1.15rem; line-height: 1.8; color: #475569; font-weight: 500;">
                A Nepal where every youth has the skills, opportunity, and platform to contribute meaningfully to an empowered, self-reliant, and equitable society.
            </p>
        </div>
        
        <div class="vm-card" style="display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 2rem;">
            <div style="width: 150px; height: 150px; border-radius: 50%; overflow: hidden; box-shadow: 0 10px 40px rgba(0,0,0,0.2); background: url('assets/education.png') center/cover; margin-bottom: 1.5rem;">
            </div>
            <h2 style="font-size: 2rem; font-weight: 800; color: #111827; margin-bottom: 1rem; font-family: var(--font-heading);">Our Impact</h2>
            <p style="font-size: 1rem; line-height: 1.7; color: #475569; margin-bottom: 1.5rem;">
                For over 02 years, we've delivered impactful programs in healthcare, child protection, literacy, and sustainability.
            </p>
            <a href="impact.html" class="btn" style="background-color: #fca311; color: #111827; padding: 0.8rem 2rem; border-radius: 30px; font-weight: 700; text-transform: uppercase;">READ MORE</a>
        </div>
    </section>

    <!-- Stats Pill Section -->
    <section class="stats-pill-section relative z-10 -mt-[120px] px-8 flex justify-center">
        <div
            class="glass-pill rounded-[40px] py-14 px-16 flex justify-around flex-wrap gap-8 w-full max-w-[1100px] text-center shadow-[0_10px_40px_rgba(0,0,0,0.12)]">

            <div class="flex-1 min-w-[180px]">
                <h3 class="stat-number text-[#fca311] text-6xl font-extrabold mb-2 leading-none" data-target="2"
                    style="font-family: var(--font-heading);">
                    0</h3>
                <p class="text-[#F8FAFC] font-bold text-[0.95rem] tracking-[1px] uppercase">
                    Experience Years</p>
            </div>

            <div class="flex-1 min-w-[180px]">
                <h3 class="stat-number text-[#fca311] text-6xl font-extrabold mb-2 leading-none" data-target="10"
                    style="font-family: var(--font-heading);">
                    0</h3>
                <p class="text-[#F8FAFC] font-bold text-[0.95rem] tracking-[1px] uppercase leading-relaxed">
                    Programs and<br>Projects</p>
                <span class="text-gray-400 text-sm block mt-2">Ongoing...</span>
            </div>

            <div class="flex-1 min-w-[180px]">
                <h3 class="stat-number text-[#fca311] text-6xl font-extrabold mb-2 leading-none" data-target="6"
                    style="font-family: var(--font-heading);">
                    0</h3>
                <p class="text-[#F8FAFC] font-bold text-[0.95rem] tracking-[1px] uppercase">
                    District Reaches</p>
            </div>

            <div class="flex-1 min-w-[180px]">
                <h3 class="stat-number text-[#fca311] text-6xl font-extrabold mb-2 leading-none" data-target="5"
                    style="font-family: var(--font-heading);">
                    0</h3>
                <p class="text-[#F8FAFC] font-bold text-[0.95rem] tracking-[1px] uppercase leading-relaxed">
                    Accreditations and<br>Awards</p>
            </div>

        </div>
    </section>

    <!-- News and Updates Section -->
    <section class="section news-section" id="news"
        style="padding-top: 8rem; padding-bottom: 6rem; background-color: #ffffff;">
        <div class="container">
            <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 3rem;">
                <h2
                    style="font-size: 2.2rem; font-weight: 700; font-family: var(--font-heading); color: #1E293B; margin: 0;">
                    समाचार र अपडेटहरू <span style="font-size: 1.2rem; color: #64748b; font-weight: normal;">(News and Updates)</span></h2>
                <a href="projects.html"
                    style="width: 45px; height: 45px; border-radius: 50%; border: 2px solid #fca311; display: flex; align-items: center; justify-content: center; color: #fca311; text-decoration: none; font-size: 1.2rem; transition: background 0.3s;"
                    onmouseover="this.style.background='#fca311'; this.style.color='#fff';"
                    onmouseout="this.style.background='transparent'; this.style.color='#fca311';">
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>

            <div class="news-grid-v2">
                <% posts.forEach(post => { %>
                <div class="news-card-v2">
                    <a href="/news/<%= post.id %>" class="news-card-image-wrap">
                        <% if (post.image_url) { %>
                            <img src="/<%= post.image_url %>" alt="<%= post.title %>">
                        <% } else { %>
                            <div style="background: #e2e8f0; height: 200px; display: flex; align-items: center; justify-content: center; color: #94a3b8;">
                                <i class="fa-solid fa-newspaper" style="font-size: 3rem;"></i>
                            </div>
                        <% } %>
                    </a>
                    <h3><%= post.title %></h3>
                    <a href="/news/<%= post.id %>" class="btn-read-more">READ MORE</a>
                </div>
                <% }) %>
                <% if (posts.length === 0) { %>
                    <p style="grid-column: span 3; text-align: center; color: var(--text-muted);">No news or updates available.</p>
                <% } %>
            </div>
        </div>
    </section>

    <!-- Testimonials Section -->
    <section class="testimonials-section">
        <div class="container">
            <div class="text-center" style="margin-bottom: 6rem;">
                <span class="section-subtitle">Testimonials</span>
                <h2
                    style="font-size: 3.5rem; font-family: var(--font-heading); font-weight: 800; color: #1E293B; line-height: 1.1;">
                    हाम्रो संस्थाको लागि<br>उत्कृष्ट सन्देशहरू <br><span style="font-size: 1.5rem; color: #64748b; font-weight: 600;">(Awesome messages for our organization)</span></h2>
            </div>

            <div class="testimonial-grid">
                <!-- Aakash Chaurasiya - Founder Message -->
                <div class="testimonial-card">
                    <div class="testimonial-avatar-wrap">
                        <div class="testimonial-avatar">
                            <img src="assets/president.jpg" alt="Aakash Chaurasiya"
                                style="width: 100%; height: 100%; object-fit: cover;">
                        </div>
                    </div>
                    <h3 class="testimonial-name">Aakash Chaurasiya</h3>
                    <span class="testimonial-role">Founder and President, Kalikamai Youth Society</span>
                    <p class="testimonial-text">"At the core of our organization lies a commitment to social justice and
                        sustainable development. From championing the Anti-Dowry Campaign to fostering Gender Equality,
                        our mission is to dismantle systemic barriers and empower the marginalized.
                        By preserving the rich Madhesi Folk Art and Culture while simultaneously driving modern Legal
                        Awareness and Environmental Stewardship, we are building a bridge between our heritage and a
                        progressive future. We remain dedicated to nurturing the inherent talents of our children and
                        ensuring a safe, drug-free environment for our youth. Together, we are not just launching
                        programs; we are spark-plugging a movement for lasting change."</p>
                    <a href="about.html" class="btn-more">ABOUT OUR STORY</a>
                </div>

                <!-- Sujit Luintel -->
                <div class="testimonial-card">
                    <div class="testimonial-avatar-wrap">
                        <div class="testimonial-avatar">
                            <img src="assets/bishal.jpg" alt="Bishal Kushwaha">
                        </div>
                    </div>
                    <h3 class="testimonial-name">Bishal Kushwaha </h3>
                    <span class="testimonial-role">Senior-Secretary</span>
                    <p class="testimonial-text">"Our journey began with a simple belief: that a community is only as
                        strong as its most vulnerable members. Whether we are on the ground for a Tree Plantation drive
                        or advocating for Legal Remedies against Women’s Violence, our goal remains the same—dignity for
                        all.
                        We believe that through Sports Competitions and Capacity Building, we can channel the energy of
                        our youth toward a brighter tomorrow. Our work in protecting our cultural identity and fighting
                        social evils like drug abuse is a testament to our collective resilience. Thank you for standing
                        with us as we strive for an equitable and empowered society"</p>
                    <a href="#" class="btn-more">MORE</a>
                </div>

            </div>
        </div>
    </section>

    <!-- Organizational Identity Section -->
    <section class="identity-section" id="identity"
        style="position: relative; width: 100%; min-height: 550px; padding: 4rem 0; background-color: #f8fafc; display: flex; align-items: center; overflow: hidden;">
        <!-- Right side background image block -->
        <div style="position: absolute; right: 0; top: 0; width: 75%; height: 100%;">
            <img src="assets/education.png" alt="Kalikamai Youth Society"
                style="width: 100%; height: 100%; object-fit: cover; filter: brightness(0.9);">
        </div>

        <!-- Left side floating yellow box -->
        <div
            style="position: relative; z-index: 10; background-color: #fca311; width: 90%; max-width: 650px; padding: 4rem 4rem 4rem 8%; border-radius: 0 40px 40px 0; box-shadow: 0 20px 50px rgba(0,0,0,0.2);">
            <h2
                style="font-size: 3.2rem; font-weight: 800; font-family: var(--font-heading); color: #1E293B; margin-bottom: 1.5rem; line-height: 1.2;">
                हामी कालिकामाई युवा समाज हौं <br><span style="font-size: 1.5rem; color: #64748b;">(We are Kalikamai Youth Society)</span></h2>
            <p style="font-size: 1.25rem; line-height: 1.5; font-weight: 600; color: #1E293B; margin: 0;">We empower
                children, young girls, women, and youth through community-based efforts, addressing diverse needs and
                building economic opportunity and justice.</p>
        </div>

        <!-- Circular Icon Button bottom right -->
        <a href="#projects"
            style="position: absolute; bottom: 2.5rem; right: 2.5rem; background-color: #fca311; width: 45px; height: 45px; border-radius: 50%; display: flex; align-items: center; justify-content: center; text-decoration: none; box-shadow: 0 5px 15px rgba(0,0,0,0.3); transition: transform 0.3s; z-index: 20;"
            onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'">
            <i class="fa-solid fa-chevron-up" style="color: #1E293B; font-size: 1.2rem;"></i>
        </a>
    </section>

    <!-- Careers and Vacancies Section -->
    <section class="section" id="careers" style="background-color: #f8fafc; padding: 6rem 0; border-top: 1px solid #e2e8f0;">
        <div class="container">
            <div style="background: white; border-radius: 30px; padding: 4rem; box-shadow: 0 15px 45px rgba(15, 23, 42, 0.05); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 3rem; border: 1px solid #f1f5f9;">
                <div style="max-width: 600px; text-align: left;">
                    <span style="color: #0ea5e9; font-weight: 700; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 1.5px; display: block; margin-bottom: 0.8rem; font-family: 'Outfit', sans-serif;">Join Our Organization</span>
                    <h2 style="font-size: 2.8rem; font-weight: 800; font-family: 'Outfit', sans-serif; color: #1e293b; line-height: 1.2; margin-bottom: 1.5rem; margin-top: 0;">रोजगारी अवसरहरू <br><span style="font-size: 1.4rem; color: #64748b;">(Careers & Openings)</span></h2>
                    <p style="font-size: 1.15rem; color: #64748b; line-height: 1.8; margin-bottom: 0;">We are dedicated to building a progressive, youth-led community that sparks lasting reforms. If you are passionate about social justice, sustainable development, and youth empowerment, explore our open positions!</p>
                </div>
                
                <div style="background: #0f172a; border-radius: 24px; padding: 2.5rem; color: white; width: 100%; max-width: 400px; box-shadow: 0 20px 40px rgba(15, 23, 42, 0.15); display: flex; flex-direction: column; gap: 1.5rem; text-align: left;">
                    <% if (vacancies.length === 0) { %>
                        <div style="display: flex; align-items: center; gap: 1rem; border-bottom: 1px dashed rgba(255,255,255,0.15); padding-bottom: 1.2rem;">
                            <i class="fa-solid fa-circle-info" style="color: #fbbf24; font-size: 2rem;"></i>
                            <h3 style="margin: 0; font-family: 'Outfit', sans-serif; font-size: 1.4rem; color: #fbbf24;">No Vacancy Available</h3>
                        </div>
                        <p style="margin: 0; font-size: 0.95rem; color: #94a3b8; line-height: 1.6;">We don't have any paid openings at the moment. However, we'd love for you to join us as a volunteer to help create a positive impact!</p>
                        <a href="#" class="btn cta-join" style="background: #fbbf24; color: #0f172a; padding: 0.8rem 1.5rem; border-radius: 12px; font-weight: 700; text-align: center; text-decoration: none; display: block; border: none; font-size: 0.95rem;">Join as a Volunteer</a>
                    <% } else { %>
                        <div style="display: flex; align-items: center; gap: 1rem; border-bottom: 1px dashed rgba(255,255,255,0.15); padding-bottom: 1.2rem;">
                            <i class="fa-solid fa-circle-check" style="color: #4ade80; font-size: 2rem;"></i>
                            <h3 style="margin: 0; font-family: 'Outfit', sans-serif; font-size: 1.4rem; color: #4ade80;">We Are Hiring!</h3>
                        </div>
                        <div>
                            <span style="font-size: 3rem; font-weight: 800; color: #fbbf24; font-family: 'Outfit', sans-serif; line-height: 1;"><%= vacancies.length %></span>
                            <span style="font-size: 1.1rem; font-weight: 600; color: #f8fafc; display: block; margin-top: 0.2rem;">Open Position(s) Available</span>
                        </div>
                        <p style="margin: 0; font-size: 0.95rem; color: #94a3b8; line-height: 1.6;">We have active paid roles open for passionate changemakers. Reach out to get specific vacancy details and apply.</p>
                        <a href="#" id="getVacancyInfoBtn" style="background: #0ea5e9; color: white; padding: 0.8rem 1.5rem; border-radius: 12px; font-weight: 700; text-align: center; text-decoration: none; display: block; font-size: 0.95rem; box-shadow: 0 4px 14px rgba(14, 165, 233, 0.4);">Get Vacancy Info</a>
                    <% } %>
                </div>
            </div>
        </div>
    </section>

    <!-- Call to Action -->
    <section class="cta-section">
        <div class="container text-center">
            <h2>तपाईंको सानो कदमले ठूलो परिवर्तन ल्याउन सक्छ! <br><span style="font-size: 1.5rem; font-weight: normal; opacity: 0.8;">(Your Little Step Can Make a Huge Impact!)</span></h2>
            <p>Join us as a volunteer, a partner, or support our causes to bring a positive change in the society.</p>
            <div class="cta-buttons">
                <a href="donate.html" class="btn btn-primary btn-lg">Donate Now</a>
                <a href="#" class="btn btn-secondary btn-lg cta-join">Become a Volunteer</a>
            </div>
        </div>
    </section>

    <!-- Developer Info Banner -->
    <section class="dev-banner" style="background: linear-gradient(135deg, #f8fafc, #e2e8f0); padding: 3rem 0; border-top: 1px solid #cbd5e1;">
        <div class="container" style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1rem;">
            <div style="width: 80px; height: 80px; border-radius: 50%; overflow: hidden; border: 3px solid #0ea5e9; box-shadow: 0 4px 10px rgba(14, 165, 233, 0.3);">
                <img src="/assets/developer.jpg" alt="Manish Kumar Sah" style="width: 100%; height: 100%; object-fit: cover; object-position: center top; transform: scale(1.35);" onerror="this.parentElement.innerHTML='<i class=\'fa-solid fa-code\' style=\'font-size: 2.5rem; color: #0ea5e9; display: flex; align-items: center; justify-content: center; height: 100%;\'></i>';">
            </div>
            <div>
                <h3 style="margin: 0; font-family: 'Outfit', sans-serif; font-size: 1.5rem; color: #1e293b;">Designed & Developed by Manish Kumar Sah</h3>
                <p style="margin: 0.5rem 0 0 0; color: #475569; font-size: 1rem;">Founder of Bikrama Technosoft | Fullstack Developer</p>
            </div>
            <a href="/developer.html" class="btn btn-outline" style="margin-top: 0.5rem; border-color: #0ea5e9; color: #0ea5e9;">Learn More About the Developer</a>
        </div>
    </section>

    <!-- Footer -->
