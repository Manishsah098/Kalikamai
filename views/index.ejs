    <!-- Volunteer Form Modal -->
    <div id="volunteerModal" class="modal-overlay">
        <div class="modal-content">
            <button id="closeModalBtn" class="modal-close"><i class="fa-solid fa-times"></i></button>
            <h2
                style="font-size: 2.2rem; font-family: var(--font-heading); color: var(--dark); margin-bottom: 0.5rem; letter-spacing: -0.5px;">
                Join as a Volunteer</h2>
            <p style="color: var(--text-muted); margin-bottom: 2rem;">Fill out the form below. Your details will
                securely be sent directly to the Google Sheet!</p>

            <!-- Backend Route for Volunteer Registration -->
            <form id="volunteerForm" action="/api/volunteers" method="POST"
                style="display: flex; flex-direction: column; gap: 0.8rem;">
                <div>
                    <label class="modal-label">Full Name *</label>
                    <input type="text" name="name" class="modal-input" required placeholder="Manish Shah">
                </div>
                <div>
                    <label class="modal-label">Email Address *</label>
                    <input type="email" name="email" class="modal-input" required placeholder="manishexample@gmail.com">
                </div>
                <div>
                    <label class="modal-label">Phone Number *</label>
                    <input type="tel" name="phone" class="modal-input" required placeholder="+977-9800000000">
                </div>
                <div>
                    <label class="modal-label">Why do you want to join? *</label>
                    <textarea name="reason" rows="3" class="modal-input" required style="resize: vertical;"
                        placeholder="Tell us about your passion..."></textarea>
                </div>

                <button type="submit" class="modal-submit">Submit Details</button>
            </form>
            <div id="formSuccessMessage"
                style="display: none; text-align: center; color: #10b981; margin-top: 1.5rem; font-weight: 600; padding: 1rem; background: #ecfdf5; border-radius: 10px;">
                <i class="fa-solid fa-check-circle" style="margin-right:0.5rem;"></i> Form submitted successfully!
            </div>
        </div>
    </div>

    <!-- Vacancy Info Modal -->
    <div id="vacancyModal" class="modal-overlay">
        <div class="modal-content" style="max-width: 650px;">
            <button id="closeVacancyModalBtn" class="modal-close"><i class="fa-solid fa-times"></i></button>
            <h2 style="font-size: 2.2rem; font-family: 'Outfit', sans-serif; color: #1e293b; margin-bottom: 0.5rem; letter-spacing: -0.5px;">Current Openings</h2>
            <p style="color: #64748b; margin-bottom: 2rem;">Join our team of passionate changemakers and contribute to youth empowerment and social development.</p>

            <div style="display: flex; flex-direction: column; gap: 1.5rem; max-height: 50vh; overflow-y: auto; padding-right: 0.5rem;">
                <% if (vacancies.length === 0) { %>
                    <p style="text-align: center; color: #94a3b8; padding: 2rem 0;">No active vacancies at this moment.</p>
                <% } else { %>
                    <% vacancies.forEach(vacancy => { %>
                        <div style="background: white; border: 1px solid #e2e8f0; border-radius: 16px; padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.8rem;">
                                <div>
                                    <h3 style="margin: 0; font-family: 'Outfit', sans-serif; font-size: 1.3rem; color: #1e293b;"><%= vacancy.title %></h3>
                                    <div style="display: flex; align-items: center; gap: 0.8rem; margin-top: 0.4rem; color: #64748b; font-size: 0.85rem;">
                                        <span><i class="fa-solid fa-map-marker-alt" style="color: #0ea5e9; margin-right: 0.3rem;"></i><%= vacancy.location %></span>
                                        <% if (vacancy.deadline) { %>
                                            <span style="display: flex; align-items: center; gap: 0.3rem;"><i class="fa-solid fa-calendar-alt" style="color: #f43f5e; margin-left: 0.5rem;"></i> Deadline: <%= new Date(vacancy.deadline).toLocaleDateString(undefined, {month: 'short', day: 'numeric', year: 'numeric'}) %></span>
                                        <% } %>
                                    </div>
                                </div>
                                <% 
                                    let badgeStyleAttr = 'style="padding: 0.25rem 0.65rem; border-radius: 20px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; background: #f3e8ff; color: #6b21a8;"';
                                    if (vacancy.type === 'Full-Time') badgeStyleAttr = 'style="padding: 0.25rem 0.65rem; border-radius: 20px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; background: #dbeafe; color: #1e40af;"';
                                    else if (vacancy.type === 'Part-Time') badgeStyleAttr = 'style="padding: 0.25rem 0.65rem; border-radius: 20px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; background: #fef3c7; color: #92400e;"';
                                    else if (vacancy.type === 'Internship') badgeStyleAttr = 'style="padding: 0.25rem 0.65rem; border-radius: 20px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; background: #d1fae5; color: #065f46;"';
                                %>
                                <span <%- badgeStyleAttr %>><%= vacancy.type %></span>
                            </div>
                            <p style="margin: 0; color: #475569; font-size: 0.95rem; line-height: 1.6; white-space: pre-line;"><%= vacancy.description %></p>
                            <div style="border-top: 1px solid #f1f5f9; padding-top: 1rem; display: flex; justify-content: flex-end;">
                                <a href="/contact.html?vacancy=<%= encodeURIComponent(vacancy.title) %>" class="btn btn-primary" style="padding: 0.6rem 1.5rem; border-radius: 8px; font-size: 0.9rem; font-weight: 600; text-decoration: none; z-index: 10; position: relative;">Apply Now</a>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </div>
    </div>

    <script src="script.js"></script>
</body>

