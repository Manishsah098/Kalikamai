<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= post.title %> | Kalikamai Youth Society</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        .story-container {
            max-width: 900px;
            margin: 0 auto;
            padding: 5rem 2rem;
        }
        .story-featured-img {
            width: 100%;
            border-radius: 20px;
            box-shadow: 0 15px 45px rgba(0,0,0,0.1);
            margin-bottom: 3rem;
            max-height: 500px;
            object-fit: cover;
        }
        .story-content {
            font-size: 1.15rem;
            line-height: 1.9;
            color: #475569;
        }
        .story-content p {
            margin-bottom: 2rem;
        }
        .story-content h2 {
            color: #1e293b;
            margin: 2.5rem 0 1.5rem;
            font-size: 1.8rem;
        }
        .story-content ul {
            margin-bottom: 2rem;
            list-style: none;
            padding-left: 0;
        }
        .story-content li {
            position: relative;
            padding-left: 2rem;
            margin-bottom: 1.5rem;
        }
        .story-content li::before {
            content: "\f058";
            font-family: "Font Awesome 6 Free";
            font-weight: 900;
            position: absolute;
            left: 0;
            color: #0ea5e9;
        }
        .story-content strong {
            color: #1e293b;
        }
    </style>
</head>

<body>

    <div class="back-btn-container">
        <button onclick="window.history.back()" class="btn btn-back">
            <i class="fa-solid fa-arrow-left"></i> <span>Go Back</span>
        </button>
    </div>

    <!-- Navigation -->
    <nav class="navbar scrolled">
        <div class="nav-container">
            <a href="/" class="logo">
                <img src="/assets/logo.jpeg" alt="Kalikamai Youth Society" class="logo-img">
                <span class="logo-text">कालिकामाई युवा<br>समाज</span>
            </a>
            <div class="nav-links">
                <a href="/about.html">About Us</a>
                <a href="/work.html">Our Work</a>
                <a href="/members.html">Our Members</a>
                <a href="/impact.html">Our Impact</a>
                <a href="/projects.html" class="active">Projects</a>
                <a href="/contact.html">Contact</a>
            </div>
            <div class="nav-actions">
                <a href="/admin/login" class="btn btn-outline">Login</a>
                <a href="/donate.html" class="btn btn-primary">Support Us</a>
                <button class="mobile-menu-btn"><i class="fa-solid fa-bars"></i></button>
            </div>
        </div>
    </nav>

    <!-- Header -->
    <header class="page-header">
        <div class="container">
            <h1 class="page-title"><%= post.title %></h1>
            <p><%= post.subtitle %></p>
        </div>
    </header>

    <!-- Main Content -->
    <main class="story-container">
        <div style="display: flex; gap: 2rem; margin-bottom: 2.5rem; color: #64748b; font-weight: 600; font-size: 1.05rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 1rem;">
            <% if (post.event_date) { %>
                <span><i class="fa-solid fa-calendar" style="color: #0ea5e9; margin-right: 0.5rem;"></i> <%= new Date(post.event_date).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
            <% } else { %>
                <span><i class="fa-solid fa-calendar" style="color: #0ea5e9; margin-right: 0.5rem;"></i> <%= new Date(post.created_at).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
            <% } %>
            <% if (post.location) { %>
                <span><i class="fa-solid fa-map-pin" style="color: #0ea5e9; margin-right: 0.5rem;"></i> <%= post.location %></span>
            <% } %>
        </div>

        <% if (post.image_url) { %>
            <img src="/<%= post.image_url %>" alt="<%= post.title %>" class="story-featured-img">
        <% } else { %>
            <div style="width: 100%; height: 400px; background: #e2e8f0; border-radius: 20px; display: flex; align-items: center; justify-content: center; margin-bottom: 3rem; color: #94a3b8; font-weight: 600;">
                [IMAGE PLACEHOLDER]
            </div>
        <% } %>
        
        <div class="story-content">
            <%- post.content %>

            <a href="/projects.html" class="btn btn-outline" style="margin-top: 2rem;">
                <i class="fa-solid fa-arrow-left"></i> Back to All Stories
            </a>
        </div>
    </main>

    <!-- Footer -->
    <footer class="footer" id="contact-footer">
        <div class="container footer-grid">
            <div class="footer-about">
                <a href="/" class="logo footer-logo">
                    <img src="/assets/logo.jpeg" alt="Kalikamai Youth Society" class="logo-img">
                </a>
                <p>Kalikamai Youth Society is dedicated to inspiring change, transforming lives, and fostering resilient
                    communities through active youth participation.</p>
                <div class="social-links">
                    <a href="https://facebook.com/" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="https://twitter.com/" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-twitter"></i></a>
                    <a href="https://instagram.com/" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-instagram"></i></a>
                    <a href="https://youtube.com/" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-youtube"></i></a>
                </div>
            </div>

            <div class="footer-links">
                <h3>Our Work</h3>
                <ul>
                    <li><a href="/work.html">Community Development</a></li>
                    <li><a href="/work.html">Education & Health</a></li>
                    <li><a href="/work.html">Environment Action</a></li>
                    <li><a href="/work.html">Crisis Response</a></li>
                </ul>
            </div>

            <div class="footer-links">
                <h3>Quick Links</h3>
                <ul>
                    <li><a href="/about.html">About Us</a></li>
                    <li><a href="/about.html#history">Our History</a></li>
                    <li><a href="/projects.html">Impact Stories</a></li>
                    <li><a href="/donate.html">Support Us</a></li>
                    <li><a href="/contact.html">Contact Us</a></li>
                </ul>
            </div>

            <div class="footer-contact">
                <h3>Contact</h3>
                <p><i class="fa-solid fa-map-pin"></i> Kalikamai RM-02 (Bhedihari), Parsa</p>
                <p><i class="fa-solid fa-phone"></i> +977-9763368173</p>
                <p><i class="fa-solid fa-envelope"></i> kalikamaiyouthsociety@gmail.com</p>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container">
                <p>&copy; 2026 Kalikamai Youth Society. All Rights Reserved. Empowering Youth.</p>
            </div>
        </div>
    </footer>

    <script src="/script.js"></script>
</body>

</html>
